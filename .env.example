# =============================================================================
# BritMart Supplier and Procurement API
# Environment-variable template
#
# Copy this file to .env for local development.
# Never commit the real .env file or genuine secrets.
# =============================================================================

# Application identity
APP_NAME=BritMart Supplier and Procurement API
APP_DESCRIPTION=Operational supplier, procurement, shipment and delivery-management API for BritMart.
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false
TIMEZONE=UTC

# API contract
API_VERSION=v1
API_PREFIX=/api/v1
DOCS_URL=/docs
REDOC_URL=/redoc
OPENAPI_URL=/openapi.json

# Local SQLite database
DATABASE_URL=sqlite:///./britmart_supplier.db
DATABASE_ECHO=false
DATABASE_POOL_PRE_PING=true
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30

# API-key authentication
# Replace this example value in the real .env file.
API_KEY_HEADER_NAME=X-API-Key
API_KEY=replace-with-a-secure-local-api-key
AUTHENTICATION_ENABLED=true

# Pagination
DEFAULT_PAGE_SIZE=100
MAXIMUM_PAGE_SIZE=1000

# Incremental extraction
INCREMENTAL_DEFAULT_LOOKBACK_DAYS=30
INCREMENTAL_MAXIMUM_WINDOW_DAYS=366

# Controlled failure simulation
FAILURE_SIMULATION_RATE=0.0
FAILURE_SIMULATION_STATUS_CODE=503
FAILURE_SIMULATION_DELAY_SECONDS=0.0

# Request and logging controls
REQUEST_TIMEOUT_SECONDS=30
LOG_LEVEL=INFO
LOG_JSON=true
REQUEST_ID_HEADER_NAME=X-Request-ID

# Health checks
HEALTH_CHECK_DATABASE_ENABLED=true
FAILURE_SIMULATION_ENABLED=false
