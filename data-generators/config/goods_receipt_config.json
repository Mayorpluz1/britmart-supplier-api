    "SUPPLIER_RECEIPT_QUARANTINE": {
      "available_quantity_multiplier": 0,
      "quarantine_quantity_multiplier": 1,
      "physical_quantity_multiplier": 1
    },
    "SUPPLIER_RECEIPT_REJECTED": {
      "available_quantity_multiplier": 0,
      "quarantine_quantity_multiplier": 0,
      "physical_quantity_multiplier": 0
